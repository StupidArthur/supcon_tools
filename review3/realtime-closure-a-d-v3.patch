+    ws.setSubscription(big)
+    await ws.start()
+    const sock = FakeWebSocket.instances[0]
+    sock.triggerOpen()
+    const sent = sock.sentMessages.find((m) => m.includes('"type":"subscribe"'))
+    const parsed = JSON.parse(sent!)
+    expect(parsed.tags.length).toBe(5000)
