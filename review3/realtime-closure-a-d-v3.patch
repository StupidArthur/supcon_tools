+	// 阶段 B2 收口：exitListenerOnce 保证 SetContext 多次调用只注册一次监听器，
+	// 避免 runtime 事件循环/页面重渲时累积空壳回调。
+	exitListenerOnce sync.Once
+	removeExitListener func()
 }
 
