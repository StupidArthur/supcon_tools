diff --git a/review3/config-tool/frontend/src/features/realtime/RealtimeRunPage.tsx b/review3/config-tool/frontend/src/features/realtime/RealtimeRunPage.tsx
index 434dc5b..9a3f4fc 100644
--- a/review3/config-tool/frontend/src/features/realtime/RealtimeRunPage.tsx
