+	b.exitMu.Lock()
+	listeners := make([]func(exitCode int, normalStop bool), len(b.exitListeners))
+	copy(listeners, b.exitListeners)
+	b.exitMu.Unlock()
+	for _, fn := range listeners {
+		if fn == nil {
+			continue
+		}
+		func() {
+			defer func() {
+				_ = recover() // 监听器 panic 必须不影响 monitorProcess
+			}()
+			fn(exitCode, normalStop)
+		}()
+	}
+}
